# =============================================================================
# Copie este arquivo para .env.local (desenvolvimento) e preencha com os valores
# do SEU projeto Supabase. Os valores abaixo são FICTÍCIOS.
# NUNCA envie .env.local para o GitHub.
# =============================================================================

# Endereço público do site (sem barra no final). Em produção: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://exemplo-projeto.supabase.co
# Chave publicável (sb_publishable_...) ou a chave "anon" legada. Pode ficar no navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO_NAO_USE
# Chave secreta (sb_secret_...) ou a "service_role" legada. SOMENTE no servidor/Vercel.
SUPABASE_SECRET_KEY=sb_secret_EXEMPLO_NAO_USE

# Segredo aleatório (mínimo 32 caracteres) para assinar os links de acompanhamento
# de pedidos. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORDER_ACCESS_SECRET=troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres

# Opcional: máximo de pedidos por IP a cada 10 minutos (proteção contra abuso). Padrão: 8.
ORDER_RATE_LIMIT=8

# Opcional: número do WhatsApp usado só enquanto o banco não estiver configurado.
# O número oficial é editado em /admin/configuracoes.
NEXT_PUBLIC_WHATSAPP_NUMBER=5583999216691

# Opcional: provedor de mapas (imagens do mapa no checkout). Vazio = OpenStreetMap
# público (somente baixo volume). Ex.: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE_PUBLICA
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# -----------------------------------------------------------------------------
# Observabilidade (opcional — veja docs/OBSERVABILIDADE.md). Vazio = desligado.
# -----------------------------------------------------------------------------
# Sentry (erros). DSN em Project Settings → Client Keys. Servidor e navegador.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: envio dos source maps no build (stack traces legíveis).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Datadog (traces via OpenTelemetry, sem agente). Chave em Organization Settings → API Keys.
DD_API_KEY=
# Site da conta: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com, datadoghq.eu…
DD_SITE=datadoghq.com

# New Relic (traces via OpenTelemetry). Use a "License key" (INGEST - LICENSE).
NEW_RELIC_LICENSE_KEY=
# Conta na UE: https://otlp.eu01.nr-data.net
NEW_RELIC_OTLP_ENDPOINT=

# OpenTelemetry genérico (qualquer coletor OTLP/HTTP). Ex.: https://meu-coletor:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Fração das requisições rastreadas (0 a 1). Padrão 1 (todas).
OTEL_TRACES_SAMPLE_RATIO=
